---
import Navbar from '../components/Navbar.astro';
import Title from '../components/Title.astro';
import Footer from '../components/Footer.astro';
import Loader from '../components/Loader.astro';
import Cursor from '../components/Cursor.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import { profile } from '../data/profile';

import '../styles/index.css';

interface Props {
  title: string;
  description?: string;
  showLoader?: boolean;
}

const { title, description = `${profile.name}, ${profile.role}`, showLoader = false } = Astro.props;
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | {profile.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/helvetica-neue-regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <SmoothScroll />
    <Cursor />
    {showLoader && <Loader />}
    <nav><Navbar /></nav>
    <header>
      <slot name="header">
        <Title title={title} />
      </slot>
    </header>
    <slot />
    <footer><Footer /></footer>
  </body>
</html>
