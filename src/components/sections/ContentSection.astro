---
import LazyVideo from '../LazyVideo.astro';
import ArrowLink from '../ArrowLink.astro';
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
  isRight: boolean;
}

const { project, isRight } = Astro.props;
const [cover] = project.videos;
---

<div class="ContentSection container-xl lg:pb-32">
  <div class="relative flex items-start justify-center flex-col">
    <LazyVideo video={cover} class:list={['Video lg:w-3/4 object-cover h-full', { 'lg:ml-auto': !isRight }]} />
    <div
      class:list={[
        'Staggered flex flex-col w-5/6 mx-auto lg-max:translate-y-[-50%] lg:absolute lg:w-1/3 p-4 lg:p-8 bg-background border border-text',
        isRight ? 'lg:right-0' : 'lg:left-0',
      ]}
    >
      <h4>{project.title}</h4>
      <p>{project.preview}</p>
      <ArrowLink href={`/projects/${project.slug}`} label="Scopri di più" class="justify-center ml-auto" />
    </div>
  </div>
</div>
