---
// localStorage key marking that the splash screen has already been shown once.
const SEEN_KEY = 'splash-seen';
// The is:inline check sits right after the markup so it runs before first paint:
// returning visitors never see the splash, not even for a frame.
---

<div class="loader w-screen h-screen flex items-center justify-center z-50" data-loader={SEEN_KEY}>
  <h3>LOADING</h3>
</div>

<script is:inline>
  (() => {
    const loader = document.querySelector('[data-loader]');
    try {
      if (localStorage.getItem(loader.dataset.loader)) loader.remove();
    } catch {
      // Storage unavailable (private mode, blocked cookies): just show the splash.
    }
  })();
</script>

<script>
  const loader = document.querySelector<HTMLElement>('[data-loader]');
  if (loader) {
    try {
      localStorage.setItem(loader.dataset.loader!, '1');
    } catch {
      // Storage unavailable: the splash will show again next time, which is harmless.
    }

    // Fade out, then take it out of the layout once the opacity transition has finished.
    setTimeout(() => loader.classList.add('hide'), 1500);
    setTimeout(() => loader.classList.replace('flex', 'hidden'), 2100);
  }
</script>
