# Copy to `.env` to override. With no `.env`, `pnpm dev` falls back to this file,
# so a fresh clone runs with no setup. The root scripts (scripts/*.mjs) load the
# file once and pass it to both apps as process env; nothing else reads it.
# Never commit real values: `.env*` is git-ignored except this file.

# --- Database ---
# Local default: PGlite served on this port by `pnpm dev` (scripts/dev-db.mjs).
# Fallback: `docker compose up -d` serves Postgres 17 on the same URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# Port and data directory for the PGlite server (optional).
PGLITE_PORT=5432
PGLITE_DATA_DIR=.pglite

# --- Payload ---
# Local-only value. Use a long random string in production.
PAYLOAD_SECRET=local-dev-secret-change-me-in-production

# Seeded accounts. The demo user is read-only (the demo guard rejects its writes).
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=local-owner-password
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=local-demo-password

# --- Service keys and secrets (local placeholders) ---
PREVIEW_API_KEY=local-preview-api-key
SUBMITTER_API_KEY=local-submitter-api-key
PREVIEW_SECRET=local-preview-secret
REVALIDATE_SECRET=local-revalidate-secret
CRON_SECRET=local-cron-secret

# --- Production only (leave empty locally) ---
VERCEL_AUTOMATION_BYPASS_SECRET=
# Empty locally: media is stored on disk in apps/cms/media/.
BLOB_READ_WRITE_TOKEN=

# --- URLs ---
CMS_URL=http://localhost:3000
WEB_URL=http://localhost:4321
