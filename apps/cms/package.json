{
  "name": "cms",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "pnpm migrate && NODE_OPTIONS=\"--no-deprecation --import ../../scripts/load-env.mjs\" next dev --port 3000",
    "build": "pnpm migrate && NODE_OPTIONS=\"--no-deprecation --import ../../scripts/load-env.mjs\" next build",
    "start": "NODE_OPTIONS=\"--no-deprecation --import ../../scripts/load-env.mjs\" next start",
    "payload": "NODE_OPTIONS=\"--no-deprecation --import ../../scripts/load-env.mjs\" payload",
    "generate:types": "pnpm payload generate:types",
    "generate:importmap": "pnpm payload generate:importmap",
    "migrate": "pnpm payload migrate",
    "migrate:create": "pnpm payload migrate:create",
    "test:int": "NODE_OPTIONS=\"--no-deprecation --import ../../scripts/load-env.mjs\" vitest run --config ./vitest.config.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "catalog:",
    "@payloadcms/next": "catalog:",
    "@payloadcms/richtext-lexical": "catalog:",
    "@payloadcms/storage-vercel-blob": "catalog:",
    "@payloadcms/ui": "catalog:",
    "graphql": "^16.14.2",
    "next": "catalog:",
    "payload": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.7.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
