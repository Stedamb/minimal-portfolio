---
import ProjectView from '../../../views/ProjectView.astro';
import { getProfile, getProject } from '../../../lib/payload';
import { cachePage, mediaTagsOf, pageTags } from '../../../lib/cache';

const [project, profile] = await Promise.all([getProject(Astro.params.slug!, 'en'), getProfile('en')]);
// A missing project (404) is not cached, so it shows up as soon as it is published.
if (!project) Astro.response.status = 404;
else cachePage(Astro.cache, pageTags.project(project.id, 'en'), mediaTagsOf(project.items));
---

<ProjectView locale="en" project={project} profile={profile} />
