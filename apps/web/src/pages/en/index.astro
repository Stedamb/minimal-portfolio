---
import HomeView from '../../views/HomeView.astro';
import { getProfile, getProjects } from '../../lib/payload';
import { cachePage, mediaTagsOf, pageTags } from '../../lib/cache';

const [profile, projects] = await Promise.all([getProfile('en'), getProjects('en', { featured: true })]);
cachePage(Astro.cache, pageTags.home('en'), mediaTagsOf([profile.photo, profile.hero, ...projects.map((p) => p.cover)]));
---

<HomeView locale="en" profile={profile} projects={projects} />
