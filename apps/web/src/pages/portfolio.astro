---
import PortfolioView from '../views/PortfolioView.astro';
import { getProfile, getProjects } from '../lib/payload';
import { cachePage, mediaTagsOf, pageTags } from '../lib/cache';

const [profile, projects] = await Promise.all([getProfile('it'), getProjects('it')]);
cachePage(Astro.cache, pageTags.portfolio('it'), mediaTagsOf(projects.map((p) => p.cover)));
---

<PortfolioView locale="it" profile={profile} projects={projects} />
