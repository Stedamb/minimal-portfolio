---
import { verifyPreviewToken } from '@repo/shared/preview-token';
import HomeView from '../../views/HomeView.astro';
import ProjectView from '../../views/ProjectView.astro';
import { getPreviewProfile, getPreviewProject } from '../../lib/payload';
import { isLocale, parsePreviewTarget, previewHeaders } from '../../lib/preview';

// Live preview (KTD7). Never cached: no `Astro.cache.set`, and every response says so.
//  - GET renders the saved draft, read with the preview API key.
//  - POST receives the admin's unsaved form state, has Payload merge it into the document and
//    renders the same page, so the frame can morph it in.
// The token in the query is verified before anything is read from Payload.

const cmsUrl = process.env.CMS_URL ?? import.meta.env.CMS_URL ?? 'http://localhost:3000';
const headers = previewHeaders(cmsUrl);
const refuse = (status: number, message: string) => new Response(message, { status, headers });
for (const [name, value] of Object.entries(headers)) Astro.response.headers.set(name, value);

const { method } = Astro.request;
const target = parsePreviewTarget(Astro.params.target);
if (method !== 'GET' && method !== 'POST') return refuse(405, 'Method not allowed');
if (!target) return refuse(404, 'Not found');

const verdict = await verifyPreviewToken({
  secret: process.env.PREVIEW_SECRET ?? import.meta.env.PREVIEW_SECRET ?? '',
  token: Astro.url.searchParams.get('token'),
  target: target.path,
});
if (!verdict.ok || !isLocale(verdict.locale)) return refuse(401, 'Unauthorized');
const locale = verdict.locale;

let data: object | undefined;
if (method === 'POST') {
  const body = (await Astro.request.json().catch(() => null)) as { data?: unknown } | null;
  if (!body?.data || typeof body.data !== 'object' || Array.isArray(body.data)) return refuse(400, 'Expected { data: object }');
  data = body.data;
}

let project = null;
let profile = null;
try {
  if (target.kind === 'project') project = await getPreviewProject(target.id, locale, data);
  else profile = await getPreviewProfile(locale, data);
} catch (error) {
  console.error('[preview]', error);
  return refuse(502, 'Preview unavailable');
}
if (!project && !profile) return refuse(404, 'Not found');
---

{
  target.kind === 'project' ? (
    <ProjectView locale={locale} project={project} preview />
  ) : (
    <HomeView locale={locale} profile={profile!} preview />
  )
}
