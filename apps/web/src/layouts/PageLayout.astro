---
import Navbar from '../components/Navbar.astro';
import Title from '../components/Title.astro';
import Footer from '../components/Footer.astro';
import Loader from '../components/Loader.astro';
import Cursor from '../components/Cursor.astro';
import SmoothScroll from '../components/SmoothScroll.astro';
import { getProfile } from '../lib/payload';
import type { ProfileView } from '../lib/mappers';
import type { Locale } from '../lib/i18n';

import '../styles/index.css';

interface Props {
  title: string;
  locale: Locale;
  description?: string;
  showLoader?: boolean;
  /** Pass the profile when the page already loaded it, to avoid a second request. */
  profile?: ProfileView;
}

const { title, locale, showLoader = false } = Astro.props;
const profile = Astro.props.profile ?? (await getProfile(locale));
const description = Astro.props.description || [profile.name, profile.role].filter(Boolean).join(', ');
---

<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | {profile.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/helvetica-neue-regular.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <SmoothScroll />
    <Cursor />
    {showLoader && <Loader locale={locale} />}
    <nav><Navbar name={profile.name} locale={locale} pathname={Astro.url.pathname} /></nav>
    <header>
      <slot name="header">
        <Title title={title} />
      </slot>
    </header>
    <slot />
    <footer><Footer name={profile.name} locale={locale} /></footer>
  </body>
</html>
