---
import ArrowLink from './ArrowLink.astro';
import { profile } from '../data/profile';

const phoneHref = `tel:${profile.phone.replace(/\s+/g, '')}`;
---

<div>
  <div class="flex flex-col lg:flex-row justify-between container-xl gap-6 lg:gap-20 pb-6 lg:pb-20">
    <div class="lg:w-1/2 h-fit relative border border-text p-8">
      <h3 class="absolute bottom-full left-8 translate-y-3">{profile.name}</h3>
      <p class="font-secondary pb-4">{profile.role}</p>
      <p>{profile.bio}</p>
      <ArrowLink href={profile.instagram} label="Instagram" target="_blank" rel="noopener noreferrer" class="justify-end w-full" />
    </div>
    <div class="lg:w-1/3">
      <div class="lazyload aspect-square">
        <img src={profile.photo} alt={`Ritratto di ${profile.name}`} loading="lazy" />
      </div>
    </div>
  </div>
  <div class="container-xl pb-20">
    <div class="relative flex items-start justify-between gap-4 lg:gap-20">
      <div class="Staggered relative flex flex-col flex-grow lg:w-1/2 p-4 lg:p-8 bg-background border border-text">
        <h4>E-mail</h4>
        <h3 class="font-secondary pt-4 lg-max:hidden">{profile.email}</h3>
        <h4 class="font-secondary pt-4 lg:hidden">{profile.email}</h4>
        <ArrowLink href={`mailto:${profile.email}`} label="Scrivimi" class="justify-center ml-auto" />
      </div>
      <div class="Staggered relative flex flex-col flex-grow lg:w-1/2 p-4 lg:p-8 bg-background border border-text">
        <h4>Telefono</h4>
        <h3 class="font-secondary pt-4 lg-max:hidden">{profile.phone}</h3>
        <h4 class="font-secondary pt-4 lg:hidden">{profile.phone}</h4>
        <ArrowLink href={phoneHref} label="Chiama" class="justify-center ml-auto" />
      </div>
    </div>
  </div>
</div>
