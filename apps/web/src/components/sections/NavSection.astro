---
import ArrowLink from '../ArrowLink.astro';
import { localePath, t, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale).home;
---

<div class="NavSection container-xl pb-20">
  <div class="relative flex items-start justify-between gap-4 lg:gap-20">
    <div class="Staggered relative flex flex-col flex-grow lg:w-1/2 p-4 lg:p-8 bg-background border border-text">
      <h4>{strings.allProjects}</h4>
      <ArrowLink href={localePath(locale, '/portfolio')} label={strings.portfolio} class="justify-center ml-auto" />
    </div>
    <div class="Staggered relative flex flex-col flex-grow lg:w-1/2 p-4 lg:p-8 bg-background border border-text">
      <h4>{strings.getInTouch}</h4>
      <ArrowLink href={localePath(locale, '/info')} label={strings.contacts} class="justify-center ml-auto" />
    </div>
  </div>
</div>
