---
import LazyVideo from './LazyVideo.astro';
import Photo from './Photo.astro';
import MovingText from './sections/MovingText.astro';
import type { MediaItem } from '../lib/mappers';
import type { Locale } from '../lib/i18n';

interface Props {
  hero?: MediaItem;
  marquee: string[];
  locale: Locale;
}

const { hero, marquee, locale } = Astro.props;
---

<div>
  <div class="container-min h-[70vh] lg:h-[80vh] lazyload">
    {
      hero?.kind === 'video' ? (
        <LazyVideo video={hero} locale={locale} class="cursor-hover play-pause" data-hero-video />
      ) : hero ? (
        <Photo photo={hero} sizes="100vw" loading="eager" />
      ) : null
    }
  </div>
  <MovingText items={marquee} />
</div>

<script>
  // State is read from the element: the lazy-video observer also plays/pauses it on scroll.
  document.querySelector<HTMLVideoElement>('video[data-hero-video]')?.addEventListener('click', (event) => {
    const video = event.currentTarget as HTMLVideoElement;
    if (video.paused) video.play().catch(() => {});
    else video.pause();
  });
</script>
