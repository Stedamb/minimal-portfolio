---
import type { HTMLAttributes } from 'astro/types';
import type { PhotoItem } from '../lib/mappers';

interface Props extends HTMLAttributes<'img'> {
  photo: PhotoItem;
}

// Responsive image: the browser picks one of the sizes generated by the CMS, and the
// focal point chosen there keeps the subject in frame when the box crops the image.
const { photo, sizes = '100vw', loading = 'lazy', style, ...rest } = Astro.props;
---

<img
  src={photo.src}
  srcset={photo.srcset || undefined}
  sizes={photo.srcset ? sizes : undefined}
  alt={photo.alt}
  width={photo.width}
  height={photo.height}
  loading={loading}
  decoding="async"
  style={`object-position: ${photo.objectPosition};${style ?? ''}`}
  {...rest}
/>
