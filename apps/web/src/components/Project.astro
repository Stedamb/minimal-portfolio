---
import LazyVideo from './LazyVideo.astro';
import Photo from './Photo.astro';
import ArrowLink from './ArrowLink.astro';
import { t, type Locale } from '../lib/i18n';
import type { ProjectView } from '../lib/mappers';

interface Props {
  project: ProjectView;
  locale: Locale;
}

const { project, locale } = Astro.props;
const meta = [project.client, project.role, project.date].filter(Boolean).join(' · ');
---

<div class="flex flex-col lg:flex-row justify-center container-xl gap-6 lg:gap-20 pb-6 lg:pb-20">
  <div class="lg:w-1/2 h-fit relative border border-text p-8">
    <h3 class="absolute bottom-full left-8 translate-y-3">{project.title}</h3>
    <p class="font-secondary pb-4">{meta}</p>
    <p>{project.description}</p>
    {project.credits && <p class="pt-4"><small>{project.credits}</small></p>}
    {
      project.externalLink && (
        <ArrowLink
          href={project.externalLink.href}
          label={project.externalLink.label}
          target="_blank"
          rel="noopener noreferrer"
          class="justify-end w-full"
        />
      )
    }
  </div>
  <div class="lg:w-1/2 flex flex-col gap-6">
    {
      project.items.map((item) => (
        <div class="flex flex-col gap-2">
          <div class="cursor-hover cursor-fullscreen transition-all duration-500 lazyload h-[200px] lg:h-[400px]" data-gallery-item>
            {item.kind === 'video' ? (
              <LazyVideo video={item} locale={locale} />
            ) : (
              <Photo photo={item} sizes="(min-width: 1024px) 50vw, 100vw" />
            )}
            {item.kind === 'photo' && item.caption && (
              <p class="hidden fixed bottom-6 inset-x-0 z-50 px-4 text-center text-background" data-gallery-caption>
                {item.caption}
              </p>
            )}
            <button type="button" class="hidden text-background Link-Alt fixed top-10 right-10 z-50" data-gallery-close>
              {t(locale).project.close}
            </button>
          </div>
          {item.kind === 'photo' && item.caption && <p><small>{item.caption}</small></p>}
        </div>
      ))
    }
  </div>
</div>

<script>
  const INLINE_CLASSES = ['lazyload', 'h-[200px]', 'lg:h-[400px]', 'cursor-hover', 'cursor-fullscreen'];
  const FULLSCREEN_CLASSES = ['fixed', 'inset-0', 'w-screen', 'h-screen', 'bg-text', 'z-50', 'flex', 'items-center', 'justify-center'];

  let openItem: HTMLElement | null = null;

  const setFullscreen = (item: HTMLElement, fullscreen: boolean) => {
    item.classList.remove(...(fullscreen ? INLINE_CLASSES : FULLSCREEN_CLASSES));
    item.classList.add(...(fullscreen ? FULLSCREEN_CLASSES : INLINE_CLASSES));
    const video = item.querySelector('video');
    if (video) video.controls = fullscreen;
    // Photos are shown whole in fullscreen instead of cropped to the inline box.
    const photo = item.querySelector('img');
    if (photo) photo.style.objectFit = fullscreen ? 'contain' : '';
    item.querySelector('[data-gallery-caption]')?.classList.toggle('hidden', !fullscreen);
    item.querySelector('[data-gallery-close]')!.classList.toggle('hidden', !fullscreen);
    openItem = fullscreen ? item : null;
    document.dispatchEvent(new CustomEvent('scroll-lock', { detail: fullscreen }));
  };

  document.querySelectorAll<HTMLElement>('[data-gallery-item]').forEach((item) => {
    item.addEventListener('click', (event) => {
      if ((event.target as Element).closest('[data-gallery-close]')) {
        setFullscreen(item, false);
      } else if (openItem !== item) {
        // While open, clicks belong to the native video controls.
        if (openItem) setFullscreen(openItem, false);
        setFullscreen(item, true);
      }
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && openItem) setFullscreen(openItem, false);
  });
</script>
