---
import LazyVideo from './LazyVideo.astro';
import Photo from './Photo.astro';
import ArrowLink from './ArrowLink.astro';
import { t, type Locale } from '../lib/i18n';
import type { ProjectView } from '../lib/mappers';

interface Props {
  project: ProjectView;
  locale: Locale;
}

const { project, locale } = Astro.props;
const meta = [project.client, project.role, project.date].filter(Boolean).join(' · ');
---

<div class="flex flex-col lg:flex-row justify-center container-xl gap-6 lg:gap-20 pb-6 lg:pb-20">
  <div class="lg:w-1/2 h-fit relative border border-text p-8 lg:sticky lg:top-16">
    <h3 class="Box-Title">{project.title}</h3>
    <p class="font-secondary pb-4">{meta}</p>
    <p>{project.description}</p>
    {project.credits && <p class="pt-4"><small>{project.credits}</small></p>}
    {
      project.externalLink && (
        <ArrowLink
          href={project.externalLink.href}
          label={project.externalLink.label}
          target="_blank"
          rel="noopener noreferrer"
          class="justify-end w-full"
        />
      )
    }
  </div>
  <div class="lg:w-1/2 flex flex-col gap-6">
    {
      project.items.map((item) => (
        <div class="flex flex-col gap-2">
          <div class="cursor-hover cursor-fullscreen transition-all duration-500 lazyload h-[200px] lg:h-[400px]" data-gallery-item>
            {item.kind === 'video' ? (
              <LazyVideo video={item} locale={locale} />
            ) : (
              <Photo photo={item} sizes="(min-width: 1024px) 50vw, 100vw" />
            )}
            {item.kind === 'photo' && item.caption && (
              <p class="hidden fixed bottom-6 inset-x-0 z-50 px-4 text-center text-background" data-gallery-caption>
                {item.caption}
              </p>
            )}
            <button type="button" class="hidden text-background Link-Alt fixed top-10 right-10 z-50" data-gallery-close>
              {t(locale).project.close}
            </button>
          </div>
          {item.kind === 'photo' && item.caption && <p><small>{item.caption}</small></p>}
        </div>
      ))
    }
  </div>
</div>

<script>
  import { initGallery } from '../scripts/gallery';

  initGallery();
</script>
