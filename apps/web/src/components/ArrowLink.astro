---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  label: string;
}

// Text link with the animated arrow used by every card call-to-action.
const { label, class: className, ...rest } = Astro.props;
---

<a class:list={['Link inline-flex items-center p-0.5', className]} {...rest}>
  <span class="p-2">{label}</span>
  <img class="Arrow" src="/arrow.svg" width="32" alt="" />
</a>
