{
  "name": "minimal-portfolio",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "concurrently -k -n db,apps -c blue,green \"node scripts/dev-db.mjs\" \"pnpm dev:apps\"",
    "dev:apps": "node scripts/dev-apps.mjs",
    "db": "node scripts/dev-db.mjs",
    "build": "pnpm --filter web build",
    "build:web": "pnpm --filter web build"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-socket": "0.2.19",
    "concurrently": "10.0.7"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@11.17.0"
}
